# Choose "gemini" (cloud, needs GOOGLE_API_KEY) or "ollama" (local, free, needs Ollama running)
LLM_PROVIDER=

# Required only when LLM_PROVIDER=gemini
GOOGLE_API_KEY=


# Used only when LLM_PROVIDER=ollama. Make sure these models are pulled:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# --- RAG / Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# --- Paths ---
DOCUMENTS_DIR=data/documents
CHROMA_DIR=chroma_db
CHROMA_COLLECTION_NAME=debate_evidence